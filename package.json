{
  "name": "typewriter",
  "version": "0.1.0",
  "description": "TypeWriter 本地 Markdown 编辑器",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check src/app.js",
    "package": "npm run build && node package.mjs"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "markdown-it": "^15.0.2",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "prosemirror-model": "^1.25.12",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "@electron/packager": "20.3.0",
    "esbuild": "^0.25.12"
  },
  "overrides": {
    "dompurify": "^3.4.16"
  },
  "productName": "TypeWriter"
}
